<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <testsuite name="Application Unit Test">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>

        <!-- Admin package testsuites. -->
        <testsuite name="Admin Feature Test">
            <directory suffix="Test.php">packages/Louzir/Admin/tests/Feature</directory>
        </testsuite>

        <!-- Core package testsuites. -->
        <testsuite name="Core Unit Test">
            <directory suffix="Test.php">packages/Louzir/Core/tests/Unit</directory>
        </testsuite>

        <!-- Customer package testsuites. -->
        <testsuite name="Customer Unit Test">
            <directory suffix="Test.php">packages/Louzir/Customer/tests/Unit</directory>
        </testsuite>

        <!-- DataGrid package testsuites. -->
        <testsuite name="DataGrid Unit Test">
            <directory suffix="Test.php">packages/Louzir/DataGrid/tests/Unit</directory>
        </testsuite>

        <!-- Installer package testsuites. -->
        <testsuite name="Installer Feature Test">
            <directory suffix="Test.php">packages/Louzir/Installer/tests/Feature</directory>
        </testsuite>

        <!-- PayU package testsuites. -->
        <testsuite name="PayU Unit Test">
            <directory suffix="Test.php">packages/Louzir/PayU/tests/Unit</directory>
        </testsuite>

        <testsuite name="PayU Feature Test">
            <directory suffix="Test.php">packages/Louzir/PayU/tests/Feature</directory>
        </testsuite>

        <!-- Razorpay package testsuites. -->
        <testsuite name="Razorpay Unit Test">
            <directory suffix="Test.php">packages/Louzir/Razorpay/tests/Unit</directory>
        </testsuite>

        <testsuite name="Razorpay Feature Test">
            <directory suffix="Test.php">packages/Louzir/Razorpay/tests/Feature</directory>
        </testsuite>

        <!-- Shop package testsuites. -->
        <testsuite name="Shop Feature Test">
            <directory suffix="Test.php">packages/Louzir/Shop/tests/Feature</directory>
        </testsuite>

        <!-- Stripe package testsuites. -->
        <testsuite name="Stripe Unit Test">
            <directory suffix="Test.php">packages/Louzir/Stripe/tests/Unit</directory>
        </testsuite>

        <testsuite name="Stripe Feature Test">
            <directory suffix="Test.php">packages/Louzir/Stripe/tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>

            <directory>packages</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>

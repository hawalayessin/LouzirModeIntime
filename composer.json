{
    "name": "louzir/mode-intime",
    "type": "project",
    "description": "LouzirModeIntime",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-calendar": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-tokenizer": "*",
        "astrotomic/laravel-translatable": "^11.16",
        "barryvdh/laravel-dompdf": "^2.0.0|^3.0",
        "diglactic/laravel-breadcrumbs": "^10.0",
        "elasticsearch/elasticsearch": "^8.10",
        "enshrined/svg-sanitize": "^0.22.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.4|^3.0",
        "kalnoy/nestedset": "^6.0",
        "khaled.alshamaa/ar-php": "^6.0.0",
        "konekt/concord": "^1.16",
        "laravel/ai": "^0.2.2",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.3",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.0",
        "maatwebsite/excel": "^3.1.46",
        "mpdf/mpdf": "^8.2",
        "nesbot/carbon": "^3.0",
        "paypal/paypal-server-sdk": "^2.0",
        "pragmarx/google2fa": "^8.0",
        "predis/predis": "^2.2",
        "prettus/l5-repository": "^2.6",
        "pusher/pusher-php-server": "^7.0",
        "razorpay/razorpay": "^2.9",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-responsecache": "^7.4",
        "spatie/laravel-sitemap": "^7.3",
        "stevebauman/purify": "^6.3",
        "stripe/stripe-php": "^17.3"
    },
    "require-dev": {
        "bagisto/laravel-datafaker": "2.3.*",
        "barryvdh/laravel-debugbar": "^3.8",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.1",
        "laravel/pint": "^1.19",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Webkul\\Admin\\": "packages/Louzir/Admin/src",
            "Webkul\\Attribute\\": "packages/Louzir/Attribute/src",
            "Webkul\\BookingProduct\\": "packages/Louzir/BookingProduct/src",
            "Webkul\\CMS\\": "packages/Louzir/CMS/src",
            "Webkul\\CartRule\\": "packages/Louzir/CartRule/src",
            "Webkul\\CatalogRule\\": "packages/Louzir/CatalogRule/src",
            "Webkul\\Category\\": "packages/Louzir/Category/src",
            "Webkul\\Checkout\\": "packages/Louzir/Checkout/src",
            "Webkul\\Core\\": "packages/Louzir/Core/src",
            "Webkul\\Customer\\": "packages/Louzir/Customer/src",
            "Webkul\\DataGrid\\": "packages/Louzir/DataGrid/src",
            "Webkul\\DataTransfer\\": "packages/Louzir/DataTransfer/src",
            "Webkul\\DebugBar\\": "packages/Louzir/DebugBar/src",
            "Webkul\\FPC\\": "packages/Louzir/FPC/src",
            "Webkul\\GDPR\\": "packages/Louzir/GDPR/src",
            "Webkul\\ImageCache\\": "packages/Louzir/ImageCache/src",
            "Webkul\\Installer\\": "packages/Louzir/Installer/src",
            "Webkul\\Inventory\\": "packages/Louzir/Inventory/src",
            "Webkul\\MagicAI\\": "packages/Louzir/MagicAI/src",
            "Webkul\\Marketing\\": "packages/Louzir/Marketing/src",
            "Webkul\\Notification\\": "packages/Louzir/Notification/src",
            "Webkul\\PayU\\": "packages/Louzir/PayU/src",
            "Webkul\\Payment\\": "packages/Louzir/Payment/src",
            "Webkul\\Paypal\\": "packages/Louzir/Paypal/src",
            "Webkul\\Product\\": "packages/Louzir/Product/src",
            "Webkul\\RMA\\": "packages/Louzir/RMA/src",
            "Webkul\\Razorpay\\": "packages/Louzir/Razorpay/src",
            "Webkul\\Rule\\": "packages/Louzir/Rule/src",
            "Webkul\\Sales\\": "packages/Louzir/Sales/src",
            "Webkul\\Shipping\\": "packages/Louzir/Shipping/src",
            "Webkul\\Shop\\": "packages/Louzir/Shop/src",
            "Webkul\\Sitemap\\": "packages/Louzir/Sitemap/src",
            "Webkul\\SocialLogin\\": "packages/Louzir/SocialLogin/src",
            "Webkul\\SocialShare\\": "packages/Louzir/SocialShare/src",
            "Webkul\\Stripe\\": "packages/Louzir/Stripe/src",
            "Webkul\\Tax\\": "packages/Louzir/Tax/src",
            "Webkul\\Theme\\": "packages/Louzir/Theme/src",
            "Webkul\\User\\": "packages/Louzir/User/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Webkul\\Admin\\Tests\\": "packages/Louzir/Admin/tests",
            "Webkul\\Core\\Tests\\": "packages/Louzir/Core/tests",
            "Webkul\\Customer\\Tests\\": "packages/Louzir/Customer/tests",
            "Webkul\\DataGrid\\Tests\\": "packages/Louzir/DataGrid/tests",
            "Webkul\\Installer\\Tests\\": "packages/Louzir/Installer/tests",
            "Webkul\\Payment\\Tests\\": "packages/Louzir/Payment/tests",
            "Webkul\\PayU\\Tests\\": "packages/Louzir/PayU/tests",
            "Webkul\\Razorpay\\Tests\\": "packages/Louzir/Razorpay/tests",
            "Webkul\\Shop\\Tests\\": "packages/Louzir/Shop/tests",
            "Webkul\\Stripe\\Tests\\": "packages/Louzir/Stripe/tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "intervention/image",
                "laravel/socialite"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "disable-tls": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "laravel/framework": "<12.0"
    }
}
